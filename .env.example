# Copy to .env for local use. Never commit a real .env file.
# Local database (only when using: docker compose --profile local-db up)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/todo_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=todoapp
SPRING_DATASOURCE_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Integrations: leave blank if not testing summary-to-Slack.
COHERE_API_KEY=
SLACK_WEBHOOK_URL=

# Frontend / monitoring
HTTP_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8081
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# For EC2 deployment, set these image names to your GHCR images.
# BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/todo-summary-assistant-backend:latest
# FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/todo-summary-assistant-frontend:latest
